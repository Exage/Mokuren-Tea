NODE_ENV=development
PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27018/mokuren_tea?replicaSet=mokuren-rs&directConnection=true
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ASSET_FOLDER=tea shop

# Administrative authentication
# Cookie carrying the server-side session token (HttpOnly).
SESSION_COOKIE_NAME=admin_session
# SameSite policy for the session cookie.
SESSION_COOKIE_SAME_SITE=lax
# Optional cookie domain; leave unset unless the frontend is on a subdomain.
SESSION_COOKIE_DOMAIN=
# Session lifetime in days (matches the server-side session TTL).
SESSION_TTL_DAYS=7
# CSRF token cookie name (readable by the page, echoed in X-CSRF-Token).
CSRF_TOKEN_NAME=csrf_token
# Exact frontend origins, comma-separated. Empty disables cross-origin access.
CORS_ORIGINS=http://localhost:3000
# Maximum login or public-reservation requests per window, per route and IP.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
# Temporary password lifetime in hours, issued on create/reset.
TEMPORARY_PASSWORD_TTL_HOURS=24
