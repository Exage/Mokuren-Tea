{
  "name": "@mokuren/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:integration": "node --test test/integration/*.test.mjs",
    "reconcile:media": "node dist/media-assets/media-assets-reconcile.cli.js reconcile",
    "recount:media-usage": "node dist/media-assets/media-assets-reconcile.cli.js recount",
    "db:up": "docker compose up -d --wait --wait-timeout 120",
    "db:down": "docker compose down",
    "db:status": "docker compose ps",
    "admin:create": "node dist/auth/admin-create.cli.js",
    "content:initialize": "node dist/cms/content-initialize.cli.js",
    "indexes:report": "node dist/database/indexes.cli.js report",
    "indexes:ensure": "node dist/database/indexes.cli.js ensure"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/mongoose": "12.0.0",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.11.0",
    "mongoose": "9.11.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.3",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.12.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
