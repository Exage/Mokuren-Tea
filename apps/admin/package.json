{
  "name": "admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.development --env-file-if-exists=.env.local --env-file-if-exists=.env.development.local scripts/wait-for-backend.mjs && next dev --port 3002",
